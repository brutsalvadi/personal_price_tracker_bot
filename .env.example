# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Paths (optional, defaults shown)
DB_PATH=data/db.json
PID_FILE=data/price_tracker.pid

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Path to system Chromium binary (optional).
# Set this if you installed Chromium via apt instead of `playwright install chromium`.
# Example (Raspberry Pi / Debian): CHROMIUM_PATH=/usr/bin/chromium-browser
# CHROMIUM_PATH=
